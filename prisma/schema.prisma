generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255)
  name       String   @db.VarChar(100)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Transaction {
  id           Int       @id @default(autoincrement())
  user_id      Int?
  date         DateTime  @db.Date
  month_label  String    @db.VarChar(7)
  event_type   String    @db.VarChar(50)
  level_1      String    @db.VarChar(50)
  level_2      String    @db.VarChar(50)
  level_3      String?   @db.VarChar(50)
  usd_amount   Decimal?  @db.Decimal(14, 2)
  fx_rate      Decimal?  @db.Decimal(10, 4)
  amount       Decimal   @db.Decimal(14, 2)
  from_account String?   @db.VarChar(50)
  to_account   String?   @db.VarChar(50)
  notes        String?   @db.Text
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([month_label])
  @@index([event_type])
  @@index([from_account])
  @@index([to_account])
}

model FxRate {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  month_label String   @db.VarChar(7)
  currency    String   @db.VarChar(10)
  rate_to_cop Decimal  @db.Decimal(10, 4)

  @@unique([month_label, currency])
  @@index([month_label])
}

model PlanVsAchievement {
  id           Int      @id @default(autoincrement())
  user_id      Int?
  month_start  DateTime @db.Date
  month_label  String   @db.VarChar(7)
  event_type   String   @db.VarChar(20)
  level_2      String   @db.VarChar(50)
  level_3      String?  @db.VarChar(50)
  base         Decimal  @db.Decimal(14, 2)
  inflation    Decimal  @db.Decimal(6, 4)
  seasonality  Decimal? @db.Decimal(6, 4)
  plan         Decimal  @db.Decimal(14, 2)
  currency     String   @default("COP") @db.VarChar(10)

  @@unique([month_label, event_type, level_2, level_3, user_id])
  @@index([month_label])
}

model EquityForecast {
  id                   Int      @id @default(autoincrement())
  user_id              Int?
  month_start          DateTime @db.Date
  month_label          String   @db.VarChar(7)
  equity_type          String   @db.VarChar(50)
  account              String   @db.VarChar(50)
  base_equity          Decimal  @db.Decimal(14, 2)
  annual_rate          Decimal  @db.Decimal(6, 4)
  monthly_rate         Decimal  @db.Decimal(8, 6)
  planned_contribution Decimal  @db.Decimal(14, 2) @default(0)
  planned_withdrawal   Decimal  @db.Decimal(14, 2) @default(0)
  projected_end        Decimal  @db.Decimal(14, 2)

  @@unique([month_label, equity_type, account])
  @@index([month_label])
}

model EquityExecuted {
  id               Int      @id @default(autoincrement())
  user_id          Int?
  month_start      DateTime @db.Date
  month_label      String   @db.VarChar(7)
  equity_type      String   @db.VarChar(50)
  platform         String   @db.VarChar(50)
  start_balance    Decimal  @db.Decimal(14, 2) @default(0)
  market_value_end Decimal? @db.Decimal(14, 2)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([month_label, equity_type, platform])
  @@index([month_label])
}

model DailyFxRate {
  id            Int      @id @default(autoincrement())
  date          DateTime @db.Date
  currency      String   @db.VarChar(10)
  rate_to_cop   Decimal  @db.Decimal(12, 4)
  rate_from_cop Decimal  @db.Decimal(12, 8)
  source        String   @default("open.er-api.com") @db.VarChar(50)
  fetched_at    DateTime @default(now())

  @@unique([date, currency])
  @@index([date])
}

model AccountDef {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  name       String   @db.VarChar(100)
  type       String   @db.VarChar(20)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Import configuration (Phase 1 — AI Import per account)
  import_enabled       Boolean  @default(false)
  statement_currency   String?  @db.VarChar(10)
  sign_logic           String?  @db.VarChar(20)
  default_counterparty String?  @db.VarChar(100)
  context_notes        String?  @db.Text

  @@unique([name, user_id])
}

model CategoryDef {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  level_1    String   @db.VarChar(50)
  level_2    String   @db.VarChar(100)
  level_3    String?  @db.VarChar(100)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([level_1, level_2, level_3, user_id])
  @@index([level_1])
  @@index([level_2])
}

model EventTypeDef {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  name       String   @db.VarChar(50)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([name, user_id])
}
